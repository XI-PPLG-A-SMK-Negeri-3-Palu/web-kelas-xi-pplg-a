generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== WEBSITE XI PPLG A =====

enum Role {
  STUDENT
  ADMIN
}

enum MemoryType {
  IMAGE
  VIDEO
}

// Border kosmetik profil -- enum, bukan String bebas, biar konsisten
// dengan tipe di shared-types dan dijaga validitasnya oleh database.
enum ProfileBorder {
  DEFAULT
  GOLD
  NEON
}

// Daftar murid yang berhak daftar (diisi manual Admin). Dicek saat
// registrasi sebelum akun User dibuat.
model Whitelist {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String
  isClaimed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String
  fullName      String
  nickname      String
  role          Role          @default(STUDENT)

  avatarUrl     String?
  bio           String?
  profileBorder ProfileBorder @default(DEFAULT)
  socialLinks   Json?

  badges        UserBadge[]
  memories      ClassMemory[]
  portfolios    Portfolio[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Badge prestasi (termasuk "Top Contributor") -- terpisah dari Role/izin akses.
model Badge {
  id          String      @id @default(uuid())
  name        String      @unique
  iconUrl     String
  description String
  users       UserBadge[]
}

model UserBadge {
  userId     String
  badgeId    String
  assignedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

// Galeri kenangan -- foto atau video.
model ClassMemory {
  id         String     @id @default(uuid())
  mediaUrl   String
  mediaType  MemoryType @default(IMAGE)
  caption    String
  uploadedBy String
  uploader   User       @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  uploadDate DateTime   @default(now())
}

// Portofolio/pencapaian -- satu user bisa punya banyak entri.
model Portfolio {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  link        String?
  imageUrl    String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
