generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------
// MODELS FOR XI PPLG A COMMUNITY HUB
// ------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  level     Int      @default(0) // 0: Guest, 1: User, 2: Verified Member
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
